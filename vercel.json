{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/secteurs/demenagement",
      "destination": "/#secteurs",
      "permanent": true
    },
    {
      "source": "/secteurs/demenagement/",
      "destination": "/#secteurs",
      "permanent": true
    },
    {
      "source": "/secteurs/demenagement/:path*",
      "destination": "/#secteurs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
